# This is an example file. Copy this to .env and fill in your own values.

# Airflow user ID for file permissions
AIRFLOW_UID=50000

# Google Cloud Project configuration
AIRFLOW_VAR_PROJECT_ID=your-gcp-project-id-here
AIRFLOW_VAR_BQ_DATASET_NAME=your_bigquery_dataset_name
AIRFLOW_VAR_BQ_TABLE_WEATHER_RAW_DATA=your_bigquery_table_name